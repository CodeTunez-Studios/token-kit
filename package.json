{
    "name": "@codetunezstudios/token-kit",
    "version": "0.1.0-beta.4",
    "description": "Official TypeScript SDK for token-kit - AI token infrastructure for developers",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "token-kit",
        "ai",
        "llm",
        "openai",
        "gpt",
        "claude",
        "bedrock",
        "amazon-nova",
        "tokens",
        "sdk",
        "typescript",
        "ai-tokens",
        "pay-per-use",
        "developer-tools",
        "api"
    ],
    "author": "Codetunez Studios",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/codetunez-studios/token-kit"
    },
    "bugs": {
        "url": "https://github.com/codetunez-studios/token-kit/issues"
    },
    "homepage": "https://token-kit.com",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "axios": "^1.6.5",
        "jest-environment-jsdom": "^30.3.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.6",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "eslint": "^8.56.0",
        "express": "^5.2.1",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "tsup": "^8.0.1",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18"
    }
}
